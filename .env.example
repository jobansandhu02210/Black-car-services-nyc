# Black Car Service (blackcarservicesnyc.com) — environment variables
# Copy to .env.local for localhost (never commit it), and add the same names in Vercel at deploy.
# Use NEW keys for this site. Step-by-step setup for each service: docs/SETUP-SERVICES.md

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000            # at deploy: https://www.blackcarservicesnyc.com
# NEXT_PUBLIC_SITE_LIVE=true                           # ONLY at launch — until then every page is noindex

# --- Google Maps: address autocomplete + driving-distance pricing -------
# Server-only key with Places API, Distance Matrix API and Geocoding API enabled (see guide).
PLACES_SERVER_API_KEY=
# Optional: extra hostnames allowed to call /api/places/* (comma-separated). localhost,
# *.vercel.app and blackcarservicesnyc.com are already allowed.
# PLACES_ALLOWED_HOST_SUFFIXES=

# --- Email (Resend) — booking, contact and invoice emails ----------------
RESEND_API_KEY=
EMAIL_FROM=Black Car Service <bookings@blackcarservicesnyc.com>   # domain must be Verified in Resend
BOOKING_NOTIFY_TO=info@blackcarservicesnyc.com                    # inbox that receives new bookings

# --- Database (Postgres, via Prisma) — bookings and invoices ------------
DATABASE_URL=

# --- Stripe — invoice payments (/invoice/[token]) ------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# --- Admin (/admin/bookings, /admin/invoice/new) -------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Pricing (optional — defaults already equal Eagle Eye's live rates) --
# Total = base fare + driving miles × per-mile rate (airport and city-to-city).
# PRICING_BASE_FARE=120
# PRICING_SEDAN=5
# PRICING_SUV=6.5
# PRICING_FIRST_SUV=8
# PRICING_FIRST_SEDAN=16
# PRICING_EXTRA_PASSENGER=15
# PRICING_EXTRA_LUGGAGE=8

# --- Analytics / Search Console (optional, at launch) --------------------
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
